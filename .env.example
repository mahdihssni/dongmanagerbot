# Public app URL used by the Telegram bot menu / Web App button
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: mark environment for analytics / feature flags later
NEXT_PUBLIC_APP_ENV=development

# Telegram bot username (without @) — used for invite deep links
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourDongBot

# Optional Mini App short name from BotFather (Direct Link)
# NEXT_PUBLIC_TELEGRAM_APP_SHORT_NAME=dong

# Allow browser-only local API auth without Telegram (must match server ALLOW_DEV_AUTH)
# NEXT_PUBLIC_ALLOW_DEV_AUTH=true

# --- Server only (never NEXT_PUBLIC) ---

# MongoDB Atlas connection string
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=dongbot

# Bot token from BotFather — required to validate WebApp initData
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Dev-only: accept x-dev-user header when Telegram initData is missing
# ALLOW_DEV_AUTH=true
