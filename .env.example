# Public app URL used by the Telegram bot menu / Web App button
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: mark environment for analytics / feature flags later
NEXT_PUBLIC_APP_ENV=development

# Telegram bot username (without @) — used for invite deep links
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourDongBot

# Optional Mini App short name from BotFather (Direct Link)
# NEXT_PUBLIC_TELEGRAM_APP_SHORT_NAME=dong

# Future backend API base (not required for localStorage mode)
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
